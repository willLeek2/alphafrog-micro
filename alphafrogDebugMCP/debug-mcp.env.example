# 复制到 ~/.alphafrog/debug-mcp.env，权限设为 600。MCP 进程启动时自己读取，不依赖某个 IDE 的 mcp.json。
# DSN 的 host/port 在 pg_via_ssh 目标上是 SSH 目标机视角的地址。

# ALPHAFROG_PG_PROD_DSN=postgresql://user:pass@203.0.113.10:5432/alphafrog
# ALPHAFROG_PG_BACKUP_TEST_SG_DSN=postgresql://user:pass@203.0.113.11:5432/alphafrog
# ALPHAFROG_PG_BETA_CN_DSN=postgresql://user:pass@127.0.0.1:5432/alphafrog
