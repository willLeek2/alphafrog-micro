# ==========================================
# 基础中间件配置 (Infrastructure)
# ==========================================

# PostgreSQL
# [Docker 运行] 若使用宿主机数据库请填: host.docker.internal
# [本地 调试] 若在 IDE 中直接运行请改为: localhost
AF_DB_MAIN_HOST=host.docker.internal
AF_DB_MAIN_PORT=5432
AF_DB_MAIN_DATABASE=alphafrog
AF_DB_MAIN_USER=alphafrog
AF_DB_MAIN_PASSWORD=alphafrog_pass

# Redis
# [Docker 运行] docker-compose.yml 中已硬编码为: redis (此变量仅供本地调试生效)
# [本地 调试] localhost
AF_REDIS_HOST=localhost
AF_REDIS_PORT=6379
# 注意：docker-compose.yml 中 Redis 密码默认为 Excited1s
AF_REDIS_PASSWORD=Excited1s

# RabbitMQ
# [Docker 运行] docker-compose.yml 中已硬编码为: rabbitmq (此变量仅供本地调试生效)
# [本地 调试] localhost
AF_RABBITMQ_HOST=localhost
AF_RABBITMQ_PORT=5672
AF_RABBITMQ_USER=alphafrog
AF_RABBITMQ_PASS=Excited1s

# Nacos
# [Docker 运行] docker-compose.yml 中已硬编码为: nacos (此变量仅供本地调试生效)
# [本地 调试] localhost
NACOS_ADDRESS=localhost
NACOS_USER=nacos
NACOS_PASSWORD=nacos

# Elasticsearch (如果启用)
AF_ES_HOST=localhost
AF_ES_PORT=9200
AF_ES_USER=elastic
AF_ES_PASSWORD=elastic

# MeiliSearch
AF_MEILI_HOST=http://localhost:7700
AF_MEILI_API_KEY=alphafrog_search_key

# ==========================================
# Java 服务通用配置 (Java Services)
# ==========================================

# JWT Security (Frontend)
# 若不填，Frontend 服务会使用 application.yml 中的默认弱密钥
AF_JWT_SECRET=Secret01234567890123456789012345678901234567890123456789
AF_JWT_EXPIRATION=86400000

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=INFO

# ==========================================
# 数据源密钥 (Data Providers)
# ==========================================

# TuShare (国内股票数据，必须配置)
# 注册地址: https://tushare.pro/
# ！！！必填，否则 domestic-fetch-service 等服务无法正常获取数据！！！
TUSHARE_TOKEN=your_tushare_token_here

# ==========================================
# Python 分析服务配置 (Analysis Service)
# ==========================================
# 注意：Analysis Service 目前未在 docker-compose.yml 中定义，假设为本地运行

# Celery Configuration (Redis Auth format: redis://:password@host:port/db)
AF_CELERY_BROKER_URL=redis://:Excited1s@localhost:6379/0
AF_CELERY_RESULT_BACKEND=redis://:Excited1s@localhost:6379/1

# 推理输出目录 (建议使用绝对路径)
AF_REASONING_OUTPUT_DIR_ROOT=/tmp/alphafrog/reasoning_output

# LLM API Keys (根据使用的服务商填写)
# DeepSeek
AF_DEEPSEEK_API_KEY=your_deepseek_api_key

# SiliconFlow
AF_SILICONFLOW_API_KEY=your_siliconflow_api_key

# Fireworks
AF_FIREWORKS_API_KEY=your_fireworks_api_key

# ==========================================
# Agent Service 配置 (OpenRouter/OpenAI)
# ==========================================
# OpenRouter 注册地址: https://openrouter.ai/
# 支持多种模型，包括 OpenAI, Anthropic, DeepSeek 等

# API 密钥 (必填)
AF_AGENT_API_KEY=your_openrouter_api_key

# API 地址 (默认 OpenRouter)
# OpenRouter: https://openrouter.ai/api/v1
# OpenAI:     https://api.openai.com/v1
AF_AGENT_BASE_URL=https://openrouter.ai/api/v1

# 模型名称 (OpenRouter 格式: provider/model)
# 示例:
#   openai/gpt-4o, openai/o3-mini, openai/gpt-4.1
#   anthropic/claude-sonnet-4, anthropic/claude-3.7-sonnet
#   deepseek/deepseek-chat-v3.1, deepseek/deepseek-r1
#   google/gemini-2.5-flash-preview-05-20
AF_AGENT_MODEL_NAME=openai/gpt-4o

# 基础参数
AF_AGENT_MAX_TOKENS=4096
AF_AGENT_TEMPERATURE=0.7

# Reasoning 配置 (可选，部分模型支持)
# 参考: https://openrouter.ai/docs/guides/best-practices/reasoning-tokens
#
# effort: 推理强度 (用于 OpenAI o系列, Grok)
#   可选值: xhigh, high, medium, low, minimal, none
# AF_AGENT_REASONING_EFFORT=high
#
# max-tokens: 推理使用的最大 token 数 (用于 Anthropic Claude, Gemini)
# AF_AGENT_REASONING_MAX_TOKENS=8000
#
# enabled: 显式启用推理 (用于 DeepSeek)
# AF_AGENT_REASONING_ENABLED=true
#
# exclude: 是否在响应中排除推理内容 (默认 false)
# AF_AGENT_REASONING_EXCLUDE=false

# ==========================================
# MCP Debug Server 配置 (alphafrogDebugMCP，Node.js 实现)
# ==========================================
# 本地运行：cd alphafrogDebugMCP && npm install && npm run build && node dist/server.js
# 以下敏感项建议放在本机 MCP 全局配置（如 ~/.claude.json / Cursor MCP env），勿提交真实值
# 工具侧仅选择 test/prod；完整变量说明见 alphafrogDebugMCP/README.md 附录（运维）

# SSH：test/prod 对应 ~/.ssh/config 中的 Host 别名（须列入 ALPHAFROG_DEBUG_SSH_HOSTS 白名单，若配置了白名单）
# ALPHAFROG_DEBUG_SSH_HOST_TEST=
# ALPHAFROG_DEBUG_SSH_HOST_PROD=
# ALPHAFROG_DEBUG_SSH_HOSTS=
# 远程仓库路径（可二选一：分环境路径，或仅填 ALPHAFROG_DEBUG_DEFAULT_REPO_PATH）
# ALPHAFROG_DEBUG_REPO_PATH_TEST=
# ALPHAFROG_DEBUG_REPO_PATH_PROD=
# ALPHAFROG_DEBUG_DEFAULT_REPO_PATH=/srv/alphafrog/alphafrog-micro
# 远程 agent data 根目录（remote_agent_data_query；按 env 分别配置，均为可选）
# ALPHAFROG_DEBUG_DATA_ROOT_TEST=
# ALPHAFROG_DEBUG_DATA_ROOT_PROD=
# Docker 日志落盘目录（remote_docker_logs / remote_docker_follow 的 save_to_file=true）
# ALPHAFROG_DEBUG_LOG_SAVE_DIR=/tmp/alphafrog-debug-logs

# PostgreSQL DSN（remote_pg_query）
# ALPHAFROG_PG_TEST_DSN=postgresql://user:pass@host:5432/alphafrog_test
# ALPHAFROG_PG_PROD_DSN=postgresql://user:pass@host:5432/alphafrog

# ==========================================
# HTTP/HTTPS 代理配置（用于访问境外 LLM 服务）
# ==========================================
# 容器经 host.docker.internal 访问宿主机 Clash 等（需 allow-lan / 监听 0.0.0.0:7890）
# agent-langchain-service 的 java.net.http.HttpClient 依赖 AF_JAVA_PROXY_OPTIONS
HTTP_PROXY=http://host.docker.internal:7890
HTTPS_PROXY=http://host.docker.internal:7890
NO_PROXY=localhost,127.0.0.1,nacos,redis,rabbitmq,meilisearch,agent-langchain-service,host.docker.internal
AF_JAVA_PROXY_OPTIONS=-Dhttp.proxyHost=host.docker.internal -Dhttp.proxyPort=7890 -Dhttps.proxyHost=host.docker.internal -Dhttps.proxyPort=7890 -Dhttp.nonProxyHosts=localhost|127.0.0.1|nacos|redis|rabbitmq|meilisearch|agent-langchain-service|host.docker.internal
# 不需要代理时：HTTP_PROXY= HTTPS_PROXY= AF_JAVA_PROXY_OPTIONS= （留空，勿删变量名）
# Python 沙箱镜像构建（Linux 默认 USE_PROXY_HOST_NETWORK=1 + --network=host）
# 无代理走国内镜像: USE_PROXY=0 PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# DOCKER_PROXY_PORT=7890
