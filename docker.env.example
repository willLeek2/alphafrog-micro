# 用法：
# - 推荐：docker compose --env-file docker.env.example up -d
# - 或者：cp docker.env.example .env && docker compose up -d

# PostgreSQL（所有 Java 服务都依赖）
AF_DB_MAIN_DATABASE=alphafrog
AF_DB_MAIN_USER=alphafrog
AF_DB_MAIN_PASSWORD=alphafrog_pass

# Redis（多个服务依赖；建议统一密码，避免默认值不一致导致 AUTH 失败）
AF_REDIS_PASSWORD=Excited1s

# RabbitMQ（消息队列；domestic-fetch-service, frontend, portfolio-service 依赖）
AF_RABBITMQ_USER=alphafrog
AF_RABBITMQ_PASS=Excited1s

# Nacos（Dubbo registry；若你启用 Nacos 鉴权再使用）
NACOS_USER=nacos
NACOS_PASSWORD=nacos

# TuShare（国内行情数据；不填会导致部分服务启动时报占位符缺失）
TUSHARE_TOKEN=please_fill_your_tushare_token

# 可选：frontend JWT 密钥覆盖（不填将使用 application.yml 默认值）
# AF_JWT_SECRET=please_fill_strong_secret

# Python 沙箱 Nacos 动态配置（python-sandbox.json data id）。
# 默认关闭；生产发布时显式设 AF_CONFIG_NACOS_ENABLED=true 才启用（Spec §7.2）。
# 动态配置只能调低沙箱输出上限，不能超过代码静态硬上限；四段输出上限测试
# （工作包 C/D）完成前，金融计算结果通道保持关闭。
# AF_CONFIG_NACOS_ENABLED=false

# --- MethodSpec V5 §12：Python 沙箱运行时镜像与保留（工作包 H） ---
# AF_SANDBOX_IMAGE 【没有默认值】，这里也刻意不提供未注释的默认行（round-2 R2-4）：
# compose 透传显式设置的值（或空），python-sandbox-service 对空值/非法值在配置
# 加载时大声报错，绝不静默退回 latest。
#
# 生产：sha256 摘要引用，由 frog 在发布时固定，例如：
# AF_SANDBOX_IMAGE=registry.example/alphafrog/runtime@sha256:<64hex>
# （占位符 REPLACE_WITH_VERIFIED_RUNTIME_IMAGE_DIGEST 不是真实值，不得用于生产。）
#
# 仅开发环境显式允许裸标签（接受 true/1）；生产保持为空。
# 开发裸标签示例（仅在同时显式开启下方开关时有效）：
# AF_SANDBOX_IMAGE=alphafrog-sandbox-runtime:latest
AF_SANDBOX_IMAGE_ALLOW_DEV_TAG=
# 仅开发环境显式允许"不完整构建"（接受 true/1）；生产保持为空，从不隐式开启。
# 开启后 docker_build.sh 允许缺失/REPLACE_WITH_... 占位符的发布输入继续构建
# （结构性 dev 构建），但产物映射标记 releasable=false；deploy_latest.sh 默认
# 仍拒绝部署非 releasable 产物，除非同样显式设置本开关。
AF_SANDBOX_ALLOW_INCOMPLETE_DEV_BUILD=
# 沙箱容器运行用户（260818 非根简化）：容器创建时即以此用户运行（docker --user），
# 容器内全程无 root，原 wrapper 降权链已移除。接受【用户名】或【uid:gid】两种形式，
# 用户须存在于运行时镜像（alphafrog-sandbox = uid 10000/gid 10001）。
# 留空 => compose 默认 alphafrog-sandbox；等价写法示例：
# AF_SANDBOX_CHILD_USER=alphafrog-sandbox
# AF_SANDBOX_CHILD_USER=10000:10001
AF_SANDBOX_CHILD_USER=
# 运行时镜像保留保护集（prune_runtime_images.sh 读取；AF_STATE_FILE 为宿主机路径）
AF_CURRENT_RUNTIME_IMAGE=
AF_PREVIOUS_RUNTIME_IMAGE=
AF_STATE_FILE=./data/sandbox_tasks/state.json

# --- Dubbo 注册地址（必填；生产与开发机的 .env 都要设置） ---
# 用途：compose 里每个 Dubbo 提供者都会把 DUBBO_IP_TO_REGISTRY/DUBBO_PORT_TO_REGISTRY
# 注入容器（值 = 本变量 + 该服务已发布的宿主端口），登记进 Nacos 的是跨机可路由
# 地址，Beta 回流生产等跨机消费者才能连上。缺失时 docker compose 解析直接失败，
# deploy_latest.sh 也会在重建容器前拒绝。
# 生产（101）填本机私网 IP，例如：AF_DUBBO_REGISTRY_HOST_IP=172.27.49.45
# 开发机填本机局域网 IP（没有跨机消费者时填 docker bridge 网关也可，但要知道
# 此时只有本机能连登记地址）。不接受 0.0.0.0 / 127.0.0.1。
# 曾按旧两步法设置过 COMPOSE_FILE=docker-compose.yml:docker-compose.beta-fallback.yml
# 的机器请删掉该行（叠加文件已删除，留着会让所有 compose 命令报错）。
# 配套：101 安全组按「Beta 会不会调这个生产提供者」放行对应 Dubbo 口（已放行
# 50052/50053/50061/50062；stock 50055、admin 50057 等按需另开）。
AF_DUBBO_REGISTRY_HOST_IP=

# --- Beta 测试机器（docker-compose.beta.yml：redis/rabbitmq/meilisearch/qdrant/otel-collector） ---
# 密码类变量与生产同名同义（AF_REDIS_PASSWORD / AF_RABBITMQ_USER / AF_RABBITMQ_PASS /
# AF_MEILI_API_KEY）。
# otel-collector 的日志导出目标没有本地默认值（beta 不跑 victorialogs），必须指到生产：
#   AF_OTEL_VICTORIALOGS_ENDPOINT=http://<生产机私网IP>:9428/insert/opentelemetry
# 其余地址都不在本文件：Nacos 地址在控制器主机配置（AF_BETA_NACOS_SERVER_ADDRESS），
# PG 用宿主机（host.docker.internal），trace 由各服务环境文件直发生产 jaeger
# （AF_OTEL_TRACES_ENDPOINT=http://<生产机私网IP>:4318）。
# 隔离原则：beta 实例只连 beta 本地依赖（PG/redis/rabbitmq/meili/qdrant）；
# domestic-stock 连 beta 本地 meili，保持默认开启、auto-sync 开（不加
# ADVANCED_MEILI_ENABLED=false）。业务服务环境由控制器逐服务环境文件提供。


