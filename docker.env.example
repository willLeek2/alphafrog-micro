# 用法：
# - 推荐：docker compose --env-file docker.env.example up -d
# - 或者：cp docker.env.example .env && docker compose up -d

# PostgreSQL（所有 Java 服务都依赖）
AF_DB_MAIN_DATABASE=alphafrog
AF_DB_MAIN_USER=alphafrog
AF_DB_MAIN_PASSWORD=alphafrog_pass

# Redis（多个服务依赖；建议统一密码，避免默认值不一致导致 AUTH 失败）
AF_REDIS_PASSWORD=Excited1s

# RabbitMQ（消息队列；domestic-fetch-service, frontend, portfolio-service 依赖）
AF_RABBITMQ_USER=alphafrog
AF_RABBITMQ_PASS=Excited1s

# Nacos（Dubbo registry；若你启用 Nacos 鉴权再使用）
NACOS_USER=nacos
NACOS_PASSWORD=nacos

# TuShare（国内行情数据；不填会导致部分服务启动时报占位符缺失）
TUSHARE_TOKEN=please_fill_your_tushare_token

# 可选：frontend JWT 密钥覆盖（不填将使用 application.yml 默认值）
# AF_JWT_SECRET=please_fill_strong_secret

# --- MethodSpec V5 §12：Python 沙箱运行时镜像与保留（工作包 H） ---
# AF_SANDBOX_IMAGE 【没有默认值】，这里也刻意不提供未注释的默认行（round-2 R2-4）：
# compose 透传显式设置的值（或空），python-sandbox-service 对空值/非法值在配置
# 加载时大声报错，绝不静默退回 latest。
#
# 生产：sha256 摘要引用，由 frog 在发布时固定，例如：
# AF_SANDBOX_IMAGE=registry.example/alphafrog/runtime@sha256:<64hex>
# （占位符 REPLACE_WITH_VERIFIED_RUNTIME_IMAGE_DIGEST 不是真实值，不得用于生产。）
#
# 仅开发环境显式允许裸标签（接受 true/1）；生产保持为空。
# 开发裸标签示例（仅在同时显式开启下方开关时有效）：
# AF_SANDBOX_IMAGE=alphafrog-sandbox-runtime:latest
AF_SANDBOX_IMAGE_ALLOW_DEV_TAG=
# 仅开发环境显式允许"不完整构建"（接受 true/1）；生产保持为空，从不隐式开启。
# 开启后 docker_build.sh 允许缺失/REPLACE_WITH_... 占位符的发布输入继续构建
# （结构性 dev 构建），但产物映射标记 releasable=false；deploy_latest.sh 默认
# 仍拒绝部署非 releasable 产物，除非同样显式设置本开关。
AF_SANDBOX_ALLOW_INCOMPLETE_DEV_BUILD=
# 沙箱子进程降权身份（工作包 C wrapper 契约，Spec §12）：接受【用户名】或
# 【uid:gid】两种形式。运行时镜像（pythonSandboxService/Dockerfile.runtime）
# 固定创建非特权用户 alphafrog-sandbox（uid 10000，gid 10001，均非零）。
# 留空 => compose 默认 alphafrog-sandbox；等价写法示例：
# AF_SANDBOX_CHILD_USER=alphafrog-sandbox
# AF_SANDBOX_CHILD_USER=10000:10001
AF_SANDBOX_CHILD_USER=
# 运行时镜像保留保护集（prune_runtime_images.sh 读取；AF_STATE_FILE 为宿主机路径）
AF_CURRENT_RUNTIME_IMAGE=
AF_PREVIOUS_RUNTIME_IMAGE=
AF_STATE_FILE=./data/sandbox_tasks/state.json


