<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>world.willfrog</groupId>
    <artifactId>run-driver-014data04</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>014-data-04 主仓库侧 run 驱动器（c6/c7/c8）</name>
    <description>
        独立 maven 项目（不进任何仓库 worktree）。Dubbo tri 直连泳道 agentLangchainService
        （group=langchain，接口 AgentDubboService），以直通用户身份创建真实 run，
        轮询到终态，拉取事件/transcript/结果，落盘 evidence。
        构建只需本机 maven + JDK17，不连泳道；真跑由泳道侧按验收顺序执行。
    </description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <dubbo.version>3.3.2</dubbo.version>
        <protobuf-java.version>3.25.3</protobuf-java.version>
    </properties>

    <dependencies>
        <!-- agentApi 用 1.0-SNAPSHOT：本分支在 alphafrog-micro 仓内，先 mvn -f agentApi/pom.xml install 装进本机 .m2 再构建本目录（分支基点 c627e5d9=v1.4，与 04 泳道构建 21530ed6 的 agentApi proto 一致）。 -->
        <dependency>
            <groupId>world.willfrog</groupId>
            <artifactId>agentApi</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <!-- install-file 未带 pom，依赖在这里显式声明，版本与主仓库对齐
             （主仓库根 pom：dubbo 3.3.2 / protobuf-java 3.25.3）。 -->
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo</artifactId>
            <version>${dubbo.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>${protobuf-java.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java-util</artifactId>
            <version>${protobuf-java.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.13</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>run-driver-014data04</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>world.willfrog.runs.driver.RunDriverMain</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
