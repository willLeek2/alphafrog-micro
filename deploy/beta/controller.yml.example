alphafrog:
  beta-controller:
    machines:
      beta-machine-1:
        docker-host: unix:///var/run/docker.sock
        # 两项地址都要替换为 Beta 机器实际使用的地址或可解析名称。
        bind-ip: BETA_BIND_ADDRESS
        routable-address: BETA_ROUTABLE_ADDRESS
        # 所有实例共用的固定 docker 网络（照生产 docker-compose.yml 的固定网络做法）：
        # 控制器首次创建后幂等复用，避免每次滚动新建网络、地址池耗尽后容器漂出
        # 172.16/12 被宿主 PostgreSQL 拒绝。子网必须留在 172.16.0.0/12 内且避开
        # docker 默认自动池（172.17 起），设置前先核对现网占用。
        network-name: alphafrog-beta
        network-subnet: 172.16.0.0/24
        network-gateway: 172.16.0.1
    services:
      domestic-stock-service:
        env-file: /etc/alphafrog-beta/services/domestic-stock-service.env
      domestic-fetch-service:
        env-file: /etc/alphafrog-beta/services/domestic-fetch-service.env
        volumes:
          - /var/lib/alphafrog-beta/data/domestic-fetch-configs:/app/config-dynamic
      admin-service:
        env-file: /etc/alphafrog-beta/services/admin-service.env
      portfolio-service:
        env-file: /etc/alphafrog-beta/services/portfolio-service.env
      agent-service:
        env-file: /etc/alphafrog-beta/services/agent-service.env
        java-tool-options: -Xms512m -Xmx1g
        volumes:
          - /var/lib/alphafrog-beta/data/agent_datasets:/data/agent_datasets
          - /var/lib/alphafrog-beta/data/database_fetched:/data/database_fetched
          - /var/lib/alphafrog-beta/data/manifests:/data/manifests
          - /var/lib/alphafrog-beta/data/agent_artifacts:/data/agent_artifacts
          - /var/lib/alphafrog-beta/data/agent_workspaces:/data/agent_workspaces
          - /var/lib/alphafrog-beta/data/agent-configs:/app/config-dynamic
      python-sandbox-service:
        env-file: /etc/alphafrog-beta/services/python-sandbox-service.env
        java-agent-enabled: false
        volumes:
          - /var/lib/alphafrog-beta/data/agent_datasets:/data/agent_datasets
          - /var/lib/alphafrog-beta/data/database_fetched:/data/database_fetched
          - /var/lib/alphafrog-beta/data/manifests:/data/manifests
          - /var/lib/alphafrog-beta/data/agent_artifacts:/data/agent_artifacts
          - /var/lib/alphafrog-beta/data/sandbox_tasks:/data/sandbox_tasks
          # 持久工作区根目录（默认关闭；开启后同一 Run 的多次 Python 调用经此目录
          # 共享文件）。宿主绝对路径，容器内挂载点与宿主路径逐字相同：沙箱服务经
          # docker.sock 驱动宿主 Docker daemon 起任务容器，任务容器的 bind 源由
          # 宿主 daemon 在宿主文件系统上解析，两侧不一致会让任务容器挂到另一个
          # 自动新建的空目录，前一次调用写入的文件在下一次调用不可见。功能关闭也
          # 保持挂载：开关只阻止为没有工作区的 Run 新建，已有工作区的旧 Run 在
          # 开关关闭后仍需继续读写与删除。开启时 env 文件必须同时显式设置三项：
          # AF_SANDBOX_PERSISTENT_WORKSPACE_ENABLED=true、
          # AF_SANDBOX_PERSISTENT_WORKSPACE_ROOT=/var/lib/alphafrog-beta/data/persistent_workspaces
          # （与本行路径逐字相同，且不得落在沙箱控制目录树内）、AF_DEPLOYMENT_ID=
          # 本部署身份（非空；清扫与删除只处理本部署启动的任务容器，空值拒绝启动）。
          # 另注意该开关与 AF_SANDBOX_POOL_ENABLED 预热池互斥，同真拒绝启动。
          - /var/lib/alphafrog-beta/data/persistent_workspaces:/var/lib/alphafrog-beta/data/persistent_workspaces
          - /var/run/docker.sock:/var/run/docker.sock
      python-sandbox-gateway-service:
        env-file: /etc/alphafrog-beta/services/python-sandbox-gateway-service.env
        java-tool-options: -Xms256m -Xmx256m
        volumes:
          - /var/lib/alphafrog-beta/data/agent-debug-observability:/app/logs/agent-debug-observability
      frontend:
        env-file: /etc/alphafrog-beta/services/frontend.env
        java-tool-options: -Xms384m -Xmx512m
        volumes:
          - /var/lib/alphafrog-beta/data/agent-debug-observability:/app/logs/agent-debug-observability
      # 四个回落生产的服务；Beta 纳入可拉起名单后按需在部署单里出现，缺映射会在
      # 提交对应服务时报 SERVICE_CONFIG_MISSING。真实 env 文件由 Beta 本机按文档 04 落盘。
      domestic-index-service:
        env-file: /etc/alphafrog-beta/services/domestic-index-service.env
      domestic-fund-service:
        env-file: /etc/alphafrog-beta/services/domestic-fund-service.env
      domestic-listed-asset-service:
        env-file: /etc/alphafrog-beta/services/domestic-listed-asset-service.env
      external-info-service:
        env-file: /etc/alphafrog-beta/services/external-info-service.env
        volumes:
          - /var/lib/alphafrog-beta/data/external-info-configs:/app/config-dynamic
