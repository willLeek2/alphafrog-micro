# 复制到 /etc/alphafrog-beta/controller.env，并保持仅 root 与 alphafrog-beta 可读。
AF_BETA_CONTROLLER_ENABLED=true
AF_BETA_CONTROLLER_BIND_ADDRESS=127.0.0.1
AF_BETA_CONTROLLER_PORT=19090
AF_BETA_CONTROLLER_STATE_ROOT=/var/lib/alphafrog-beta
AF_BETA_CONTROLLER_RECONCILE_DELAY=PT2S
AF_BETA_APPLICATION_DRAIN_SECONDS=60
AF_BETA_CONTROLLER_API_TOKEN_FILE=/etc/alphafrog-beta/secrets/controller-api-token
AF_BETA_HEALTHCHECK_SCRIPT=/opt/alphafrog-beta/bin/tcp-healthcheck

# 替换为生产 Nacos 从 Beta 机器可访问的地址。用户名和密码没有默认示例值。
AF_BETA_NACOS_SERVER_ADDRESS=<production-nacos-host>:8848
AF_CONFIG_NACOS_NAMESPACE=public
AF_CONFIG_NACOS_USERNAME=
AF_CONFIG_NACOS_PASSWORD=

# Java 服务把轨迹直接发到生产 Jaeger；日志由 Beta 本机 Collector 从文件读取。
AF_OTEL_TRACES_ENDPOINT=http://<production-jaeger-host>:4318
AF_BETA_OTEL_JAVAAGENT_JAR=/opt/alphafrog-beta/otel/opentelemetry-javaagent.jar

# 机器和服务清单使用 YAML 表达，避免把带连字符的映射键编码进环境变量名。
SPRING_CONFIG_ADDITIONAL_LOCATION=file:/etc/alphafrog-beta/controller.yml
