{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "method-spec-v1.schema.json",
  "title": "AlphaFrog MethodSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "methodId", "version", "displayName", "definition", "parameters", "outputs"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "methodId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+$",
      "minLength": 3
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "displayName": {"type": "string", "minLength": 1, "maxLength": 128},
    "definition": {"type": "string", "minLength": 1, "maxLength": 2048},
    "resolverHints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 128},
          "maxItems": 64
        },
        "commonPhrases": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 256},
          "maxItems": 64
        },
        "clarificationDimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "question"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$", "maxLength": 64},
              "question": {"type": "string", "minLength": 1, "maxLength": 512}
            }
          },
          "maxItems": 32
        }
      }
    },
    "parameters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {"enum": ["string", "number", "integer", "boolean", "array", "object"]},
          "required": {"type": "boolean"},
          "default": true,
          "minimum": {"type": "number"},
          "maximum": {"type": "number"},
          "enum": {"type": "array", "minItems": 1, "maxItems": 64},
          "items": {"type": "object"},
          "meaning": {"type": "string", "minLength": 1, "maxLength": 512},
          "description": {"type": "string", "minLength": 1, "maxLength": 1024}
        }
      }
    },
    "conventions": {
      "type": "object",
      "additionalProperties": {"type": "object"}
    },
    "extensions": {
      "type": "object",
      "additionalProperties": {"type": "object"}
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "unit", "description"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-zA-Z0-9_]*$", "maxLength": 64},
          "unit": {"type": "string", "minLength": 1, "maxLength": 64},
          "description": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "libraryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "function", "apiCompatRange"],
      "properties": {
        "package": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$", "maxLength": 128},
        "function": {"type": "string", "pattern": "^[a-z][a-zA-Z0-9_]*$", "maxLength": 128},
        "apiCompatRange": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "sourceRefs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 512},
      "maxItems": 64
    }
  }
}
